# =============================================================================
# OMNIME configuration
# =============================================================================
# Copy this file to .env and fill in your values. Never commit .env.

# === REQUIRED ===
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_USER_ID=your_numeric_user_id
ANTHROPIC_API_KEY=your_anthropic_api_key

# === LLM PROVIDERS ===
LLM_PROVIDER=anthropic
LLM_MODEL_FAST=claude-sonnet-4-6
LLM_MODEL_POWERFUL=claude-opus-4-7
# Tiny tier: cheap operations (intent classification, sentiment, entity extraction).
# Haiku 4.5 is ~10× cheaper than Sonnet for input tokens.
LLM_MODEL_TINY=claude-haiku-4-5-20251001

# Optional fallback provider (anthropic | openai | ollama)
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# OpenAI (only if using OpenAI as primary or fallback)
OPENAI_API_KEY=

# Ollama (local, optional)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# === DATABASE ===
DB_HOST=postgres
DB_PORT=5432
DB_NAME=omnime
DB_USER=omnime
DB_PASSWORD=change_this_to_a_secure_password

# === CHROMADB ===
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# === OPTIONAL: Gmail integration ===
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# === OPTIONAL: Google Calendar integration ===
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GCAL_REFRESH_TOKEN=

# === OPTIONAL: GitHub integration (for self-evolution) ===
GITHUB_TOKEN=
GITHUB_REPO=

# === GENERAL ===
LOG_LEVEL=INFO
TIMEZONE=UTC
DAILY_BRIEFING_TIME=08:00
LANGUAGE=auto

# Fernet encryption key for sensitive data at rest (generate with `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`)
ENCRYPTION_KEY=

# === RUNTIME MODE ===
# polling for development, webhook for production
TELEGRAM_MODE=polling
WEBHOOK_URL=
WEBHOOK_PORT=8443

# === FEATURE FLAGS ===
# Disable any of these if the corresponding Anthropic SDK feature misbehaves.
ENABLE_PROMPT_CACHING=true
ENABLE_STREAMING=true
EVOLUTION_USE_DOCKER=false

# === BACKUPS ===
# A daily archive (postgres dump + structured JSON + uploaded files) is built at
# BACKUP_AT and pruned to BACKUP_KEEP copies. Pick where to ship it.
BACKUP_ENABLED=true
BACKUP_AT=03:00
BACKUP_KEEP=14

# Off-site target. One of: none | s3 | b2 | scp | rclone
BACKUP_REMOTE=none

# S3 / R2 / B2 (S3-compatible). Endpoint can stay empty for AWS S3.
S3_BUCKET=
S3_PREFIX=omnime
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# SCP target — `user@host:/path/`. Mount the key into the container at SCP_KEY_PATH.
SCP_TARGET=
SCP_KEY_PATH=

# Rclone remote — install rclone in the container yourself if you use this.
RCLONE_REMOTE=
